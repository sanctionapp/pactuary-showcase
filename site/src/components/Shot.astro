---
import { Image } from "astro:assets";
import { shotImage } from "../lib/shots";

interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  sizes?: string;
}

const { name, alt, eager = false, sizes = "(max-width: 860px) 100vw, 680px" } = Astro.props;

const light = shotImage(`${name}-light.webp`);
const dark = shotImage(`${name}-dark.webp`);
const widths = [640, 960, 1280, 1920];
---
<figure class="frame">
  <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i></div>
  {light ? (
    <>
      <Image
        class={dark ? "shot-light" : undefined}
        src={light}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={78}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
      {dark && (
        <Image class="shot-dark" src={dark} alt={alt} widths={widths} sizes={sizes} format="webp" quality={78} loading="lazy" />
      )}
    </>
  ) : (
    <div class="shot-missing">screenshot pending: {name}</div>
  )}
</figure>
