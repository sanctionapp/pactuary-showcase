---
import Icon from "./Icon.astro";
import type { Dict } from "../i18n/en";
import { LINKS, demoMailto } from "../consts";

interface Props { t: Dict }
const { t } = Astro.props;
const lang = t.lang as "en" | "tr";
const home = lang === "tr" ? "/tr/" : "/";
---
<section class="about-hero">
  <div class="wrap">
    <p class="eyebrow">{t.about.eyebrow}</p>
    <h1>{t.about.title}</h1>
    <p class="lead" style="margin-top:1.5rem">{t.about.intro}</p>
  </div>
</section>
<section class="section" style="padding-top:2rem">
  <div class="wrap about-grid">
    <div class="prose">
      <section>
        <h2>{t.about.whyTitle}</h2>
        {t.about.why.map((p) => <p>{p}</p>)}
      </section>
      <section>
        <h2>{t.about.howTitle}</h2>
        {t.about.how.map((p) => <p>{p}</p>)}
      </section>
      <section>
        <h2>{t.about.roleTitle}</h2>
        <p>{t.about.role}</p>
        <p>{t.about.source}</p>
        <p><a href={home}>{t.about.back} →</a></p>
      </section>
    </div>
    <aside class="recruiter" aria-labelledby="recruiter-title">
      <h2 id="recruiter-title">{t.about.recruiterTitle}</h2>
      <ol>{t.about.recruiter.map((r) => <li>{r}</li>)}</ol>
      <p class="open">{t.about.openTo}</p>
      <div class="links">
        <a class="btn btn-primary" href={LINKS.linkedin} target="_blank" rel="me noopener">{t.about.linkedin}</a>
        <a class="btn btn-ghost" href={LINKS.githubProfile} target="_blank" rel="me noopener"><Icon name="github" />{t.about.github}</a>
        <a class="btn btn-ghost" href={demoMailto(lang)}><Icon name="mail" />{t.about.contact}</a>
      </div>
    </aside>
  </div>
</section>
